# Скопируйте этот файл в .env.local и заполните значениями из вашего проекта Supabase
# Settings -> API в панели Supabase

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Только для приглашения новых участников команды (кнопка «Пригласить» на /team).
# Settings -> API -> Project API keys -> service_role (секретный ключ, НЕ anon).
# Используется только на сервере (в app/api/invite) — никогда не попадает в браузер.
# Без этой переменной кнопка «Пригласить» будет показывать ошибку.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
